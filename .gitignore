# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IDE files
.idea/
.vscode/
.vs/
*.iml
*.ipr
*.iws

# Tooling / local agent session data
.zcode/
.freebuff/
.fvm/

# Temporary root-level folders (not part of the app)
/images/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Locally generated installer packages
/installer/output/

# Accidental Windows reserved-device filename
/nul

# Windows specific build artifacts
windows/flutter/ephemeral/
*.pdb
CMakeUserPresets.json

# QA/temp scratch data
/tmp/

# Rust native modules (v2.0.5+, rust/ghita_core) — build artifacts only;
# Cargo.lock và source được commit để build tái lập như pubspec.lock
/rust/target/
**/*.rs.bk

# Coverage / QA output (regenerated by flutter test --coverage)
coverage/

# OS / editor junk
Thumbs.db
Desktop.ini
*.bak
*.orig
*.tmp
*.dmp

# Local scratch documents (internal notes never belong in git)
*.local.md
